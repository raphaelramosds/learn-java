        </constraints>
        <properties>
          <text value="Clique aqui"/>
        </properties>
      </component>
      <component id="d7612" class="javax.swing.JLabel" binding="lblTime">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Clique no botão!"/>
        </properties>
      </component>
    </children>
